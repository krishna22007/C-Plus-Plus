#include <iostream>
using namespace std;

class Cart
{
    double amount;

public:
    Cart(double a)
    {
        amount = a;
    }

    double total() const
    {
        return amount;
    }
};

int main()
{
    Cart *carts[3];

    carts[0] = new Cart(500);
    carts[1] = new Cart(900);
    carts[2] = new Cart(700);

    int highest = 0;

    for (int i = 1; i < 3; i++)
    {
        if (carts[i]->total() > carts[highest]->total())
        {
            highest = i;
        }
    }

    cout << "Highest Cart Total: "
         << carts[highest]->total() << endl;

    for (int i = 0; i < 3; i++)
        delete carts[i];

    return 0;
}
