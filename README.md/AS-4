#include <iostream>
#include <string>
#include <vector>
using namespace std;

class Vehicle
{
protected:
    string registrationNo;
    double dailyRate;
    bool rented;

public:
    Vehicle(string r, double d)
    {
        registrationNo = r;
        dailyRate = d;
        rented = false;
    }

    virtual void display() const = 0;

    virtual double charge(int days) const = 0;

    void rent()
    {
        if (rented)
        {
            cout << registrationNo << " is already rented" << endl;
        }
        else
        {
            rented = true;
            cout << registrationNo << " rented successfully" << endl;
        }
    }

    void returnVehicle(int days, int lateDays)
    {
        if (!rented)
        {
            cout << registrationNo << " was not rented" << endl;
            return;
        }

        double rentalCharge = charge(days);
        double lateCharge = lateDays * dailyRate * 1.5;

        cout << "Rental Charge: " << rentalCharge << endl;
        cout << "Late Charge: " << lateCharge << endl;
        cout << "Total Charge: "
             << rentalCharge + lateCharge << endl;

        rented = false;

        cout << registrationNo << " returned successfully" << endl;
    }

    virtual ~Vehicle()
    {
    }
};

class Bicycle : public Vehicle
{
public:
    Bicycle(string r, double d) : Vehicle(r, d)
    {
    }

    double charge(int days) const override
    {
        return days * dailyRate;
    }

    void display() const override
    {
        cout << "Bicycle: " << registrationNo
             << " Daily Rate: " << dailyRate << endl;
    }
};

class MotorVehicle : public Vehicle
{
protected:
    double fuelLevel;
    string serviceDate;

public:
    MotorVehicle(string r, double d, double f, string s)
        : Vehicle(r, d)
    {
        fuelLevel = f;
        serviceDate = s;
    }
};

class TwoWheeler : public MotorVehicle
{
public:
    TwoWheeler(string r, double d, double f, string s)
        : MotorVehicle(r, d, f, s)
    {
    }

    double charge(int days) const override
    {
        return days * dailyRate;
    }

    void display() const override
    {
        cout << "TwoWheeler: " << registrationNo
             << " Fuel: " << fuelLevel
             << " Service: " << serviceDate << endl;
    }
};

class Car : public MotorVehicle
{
protected:
    int seats;

public:
    Car(string r, double d, double f, string s, int st)
        : MotorVehicle(r, d, f, s)
    {
        seats = st;
    }

    double charge(int days) const override
    {
        return days * dailyRate;
    }

    void display() const override
    {
        cout << "Car: " << registrationNo
             << " Seats: " << seats
             << " Fuel: " << fuelLevel << endl;
    }
};

class ElectricCar : public Car
{
protected:
    double batteryCapacity;
    double ratePerKwh;

public:
    ElectricCar(string r, double d, double f, string s,
                int st, double b, double k)
        : Car(r, d, f, s, st)
    {
        batteryCapacity = b;
        ratePerKwh = k;
    }

    double charge(int days) const override
    {
        return days * dailyRate + batteryCapacity * ratePerKwh;
    }

    void display() const override
    {
        cout << "Electric Car: " << registrationNo
             << " Seats: " << seats
             << " Battery: " << batteryCapacity << " kWh" << endl;
    }
};

class ElectricBus : public ElectricCar
{
public:
    ElectricBus(string r, double d, int st, double b, double k)
        : ElectricCar(r, d, 0, "Not Applicable", st, b, k)
    {
    }

    double charge(int days) const override
    {
        return days * dailyRate + batteryCapacity * ratePerKwh;
    }

    void display() const override
    {
        cout << "Electric Bus: " << registrationNo
             << " Seats: " << seats
             << " Battery: " << batteryCapacity << " kWh" << endl;
    }
};

int main()
{
    vector<Vehicle*> fleet;

    fleet.push_back(new Bicycle("BIKE101", 100));
    fleet.push_back(new TwoWheeler("TW102", 300, 5, "2026-12-10"));
    fleet.push_back(new Car("CAR103", 1000, 20, "2026-12-15", 5));
    fleet.push_back(new ElectricCar("EV104", 1500, 0, "2026-12-20",
                                    5, 50, 8));
    fleet.push_back(new ElectricBus("BUS105", 3000, 30, 100, 10));

    cout << "VEHICLE DETAILS" << endl;

    for (size_t i = 0; i < fleet.size(); i++)
        fleet[i]->display();

    cout << "\nRENTING VEHICLES" << endl;

    for (size_t i = 0; i < fleet.size(); i++)
        fleet[i]->rent();

    cout << "\nRETURNING VEHICLES" << endl;

    for (size_t i = 0; i < fleet.size(); i++)
    {
        fleet[i]->returnVehicle(2, 1);
        cout << endl;
    }

    for (size_t i = 0; i < fleet.size(); i++)
        delete fleet[i];

    fleet.clear();

    return 0;
}
