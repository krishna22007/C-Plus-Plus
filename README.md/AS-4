class Address
{
    string city;
    int pin;

public:
    Address(string c, int p) : city(c), pin(p)
    {
        cout << "Address constructed" << endl;
    }

    string str() const
    {
        return city + "-" + to_string(pin);
    }

    ~Address()
    {
        cout << "Address destroyed" << endl;
    }
};

class Student : public Person
{
    long long regNo;
    Address home;

public:
    Student(string n, int a, long long r, string c, int p)
        : Person(n, a), regNo(r), home(c, p)
    {
        cout << "Student constructed" << endl;
    }

    void print() const
    {
        cout << regNo << " " << name << " ("
             << age << ") " << home.str() << endl;
    }

    ~Student()
    {
        cout << "Student destroyed" << endl;
    }
};

int main()
{
    Student s("Kavya", 19, 192311001, "Salem", 636001);
    s.print();

