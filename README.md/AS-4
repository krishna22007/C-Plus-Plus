#include <iostream>
using namespace std;

class Cart
{
    double totalAmount;

public:
    Cart()
    {
        totalAmount = 0;
    }

    Cart& add(double amount)
    {
        totalAmount += amount;
        return *this;
    }

    double total() const
    {
        return totalAmount;
    }
};

int main()
{
    Cart c1;
    c1.add(100);
    cout << "Direct: " << c1.total() << endl;

    Cart c2;
    Cart *p = &c2;
    p->add(200);
    cout << "Pointer: " << p->total() << endl;

    Cart c3;
    Cart &r = c3;
    r.add(300);
    cout << "Reference: " << r.total() << endl;

    Cart *p2 = new Cart;
    p2->add(400);
    cout << "Dynamic: " << p2->total() << endl;

    delete p2;

    return 0;
}
