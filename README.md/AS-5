#include <iostream>
#include <string>
using namespace std;

class Bill {
protected:
    string patient;
    double amount;

public:
    Bill(string p, double a) {
        patient = p;
        amount = a;
    }

    virtual double total() const {
        return amount;
    }

    string getPatient() const {
        return patient;
    }

    virtual ~Bill() {}
};

class Payer {
public:
    virtual double amountCovered(const Bill& bill) const = 0;
    virtual string type() const = 0;

    virtual ~Payer() {}
};

class SelfPay : public Payer {
public:
    double amountCovered(const Bill& bill) const override {
        return bill.total();
    }

    string type() const override {
        return "Self Pay";
    }
};

class Insurance : public Payer {
    double coverLimit;
    double coPayment;

public:
    Insurance(double limit, double percentage) {
        coverLimit = limit;
        coPayment = percentage;
    }

    double amountCovered(const Bill& bill) const override {
        double covered = bill.total() * (1 - coPayment / 100);

        if (covered > coverLimit) {
            covered = coverLimit;
        }

        return covered;
    }

    string type() const override {
        return "Insurance";
    }
};

class GovernmentScheme : public Payer {
    double packageRate;

public:
    GovernmentScheme(double rate) {
        packageRate = rate;
    }

    double amountCovered(const Bill& bill) const override {
        if (bill.total() < packageRate) {
            return bill.total();
        }

        return packageRate;
    }

    string type() const override {
        return "Government Scheme";
    }
};

class CorporatePayer : public Payer {
    double percentage;

public:
    CorporatePayer(double p) {
        percentage = p;
    }

    double amountCovered(const Bill& bill) const override {
        return bill.total() * percentage / 100;
    }

    string type() const override {
        return "Corporate Payer";
    }
};

int main() {
    Bill bill("Ravi", 50000);

    Payer* payers[4];

    payers[0] = new SelfPay();
    payers[1] = new Insurance(40000, 20);
    payers[2] = new GovernmentScheme(30000);
    payers[3] = new CorporatePayer(75);

    cout << "Patient: " << bill.getPatient() << endl;
    cout << "Bill Amount: " << bill.total() << endl;

    for (int i = 0; i < 4; i++) {
        cout << payers[i]->type() << " Covers: "
             << payers[i]->amountCovered(bill) << endl;
    }

    for (int i = 0; i < 4; i++) {
        delete payers[i];
    }

    return 0;
}
