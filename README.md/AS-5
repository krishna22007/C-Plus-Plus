#include <iostream>
#include <stdexcept>
using namespace std;

class ClaimError : public runtime_error {
public:
    using runtime_error::runtime_error;
};

double approve(double billed, double cover) {
    if (billed < 0 || cover < 0) {
        throw invalid_argument("negative amount");
    }

    if (billed > cover) {
        throw ClaimError("exceeds cover");
    }

    return billed;
}

double settle(double billed, double cover) {
    try {
        return approve(billed, cover);
    }
    catch (const ClaimError& e) {
        cout << "audit: " << e.what() << endl;
        throw;
    }
}

void validate(double amount) {
    if (amount < 0) {
        throw invalid_argument("negative");
    }

    if (amount > 1000000) {
        throw out_of_range("too large");
    }

    cout << "ok ";
}

void process(double amount) {
    try {
        validate(amount);
    }
    catch (const out_of_range& e) {
        cout << "[log " << e.what() << "] ";
        throw;
    }
}

int main() {
    double cases[][2] = {
        {40000, 50000},
        {60000, 50000},
        {-1, 50000}
    };

    for (auto& c : cases) {
        try {
            double paid = settle(c[0], c[1]);
            cout << "approved " << paid << endl;
        }
        catch (const ClaimError& e) {
            cout << "claim rejected: " << e.what() << endl;
        }
        catch (const exception& e) {
            cout << "error: " << e.what() << endl;
        }
    }

    cout << "Validation Tests" << endl;

    for (double amount : {100.0, -5.0, 2000000.0}) {
        try {
            process(amount);
            cout << "done ";
        }
        catch (const exception& e) {
            cout << "caught " << e.what() << " ";
        }
    }

    cout << endl;

    try {
        int* data = new int[1000000000000000000ULL];
        delete[] data;
    }
    catch (const bad_alloc& e) {
        cout << "Memory allocation failed" << endl;
    }
    catch (const exception& e) {
        cout << "Allocation error: " << e.what() << endl;
    }

    return 0;
}
