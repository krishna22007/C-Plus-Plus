#include <iostream>
#include <string>
using namespace std;

class Bill {
protected:
    string patient;

public:
    Bill(string p) {
        patient = p;
    }

    virtual double total() const = 0;
    virtual string type() const = 0;

    virtual void print() const {
        cout << type() << " Bill - " << patient << ": " << total() << endl;
    }

    virtual ~Bill() {}
};

class OutPatientBill : public Bill {
    double consultation, tests;

public:
    OutPatientBill(string p, double c, double t) : Bill(p) {
        consultation = c;
        tests = t;
    }

    double total() const override {
        return consultation + tests;
    }

    string type() const override {
        return "OutPatient";
    }
};

class InPatientBill : public Bill {
    int days;
    double roomCharge, procedure, medicines;

public:
    InPatientBill(string p, int d, double r, double pr, double m) : Bill(p) {
        days = d;
        roomCharge = r;
        procedure = pr;
        medicines = m;
    }

    double total() const override {
        return days * roomCharge + procedure + medicines;
    }

    string type() const override {
        return "InPatient";
    }
};

class DayCareBill : public Bill {
    double packagePrice;

public:
    DayCareBill(string p, double price) : Bill(p) {
        packagePrice = price;
    }

    double total() const override {
        return packagePrice;
    }

    string type() const override {
        return "DayCare";
    }
};

class EmergencyBill : public Bill {
    double baseCharge, hourlyCharge;
    int hours;

public:
    EmergencyBill(string p, double b, double h, int hr) : Bill(p) {
        baseCharge = b;
        hourlyCharge = h;
        hours = hr;
    }

    double total() const override {
        return baseCharge + hourlyCharge * hours;
    }

    string type() const override {
        return "Emergency";
    }
};

int main() {
    Bill* bills[4];

    bills[0] = new OutPatientBill("Ravi", 500, 1200);
    bills[1] = new InPatientBill("Meena", 3, 2500, 40000, 5000);
    bills[2] = new DayCareBill("Arun", 15000);
    bills[3] = new EmergencyBill("Priya", 2000, 500, 4);

    double dayTotal = 0;

    for (int i = 0; i < 4; i++) {
        bills[i]->print();
        dayTotal += bills[i]->total();
    }

    cout << "Total Hospital Billing: " << dayTotal << endl;

    for (int i = 0; i < 4; i++) {
        delete bills[i];
    }

    return 0;
}
