class BillingError : public runtime_error {
public:
    BillingError(string message) : runtime_error(message) {}
};

class ClaimError : public BillingError {
public:
    ClaimError(string message) : BillingError(message) {}
};

class InvalidCharge : public BillingError {
public:
    InvalidCharge(string message) : BillingError(message) {}
};

class PatientNotFound : public BillingError {
public:
    PatientNotFound(string message) : BillingError(message) {}
};

class UnknownPackage : public BillingError {
public:
    UnknownPackage(string message) : BillingError(message) {}
};

class Guard {
    string name;

public:
    Guard(string n) {
        name = n;
    }

    ~Guard() noexcept {
        cout << "Releasing " << name << endl;
    }
};

void validateBill(double amount) {
    if (amount < 0) {
        throw InvalidCharge("Negative bill amount");
    }

    if (amount > 1000000) {
        throw ClaimError("Bill amount exceeds limit");
    }

    cout << "Bill is valid" << endl;
}

void processBill(double amount) {
    Guard resource("Bill Resource");

    try {
        validateBill(amount);
    }
    catch (const BillingError& e) {
        cout << "Audit Log: " << e.what() << endl;
        throw;
    }
}

int main() {
    double amounts[] = {5000, -100, 1500000};

    for (int i = 0; i < 3; i++) {
        try {
            processBill(amounts[i]);
            cout << "Bill processed successfully" << endl;
        }
        catch (const BillingError& e) {
            cout << "Billing Error: " << e.what() << endl;
        }
        catch (const exception& e) {
            cout << "General Error: " << e.what() << endl;
        }
        catch (...) {
            cout << "Unknown Error" << endl;
        }
    }

    return 0;
}
