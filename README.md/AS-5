#include <iostream>
#include <vector>
#include <variant>
#include <chrono>
#include <stdexcept>
using namespace std;
using namespace chrono;

class Bill {
public:
    virtual double total() const = 0;
    virtual ~Bill() {}
};

class OutPatient : public Bill {
    double consultation, tests;

public:
    OutPatient(double c, double t) {
        consultation = c;
        tests = t;
    }

    double total() const override {
        return consultation + tests;
    }
};

class InPatient : public Bill {
    int days;
    double rate, surgery;

public:
    InPatient(int d, double r, double s) {
        days = d;
        rate = r;
        surgery = s;
    }

    double total() const override {
        return days * rate + surgery;
    }
};

struct SimpleBill {
    int type;
    double a, b, c;

    double total() const {
        if (type == 1) {
            return a + b;
        }

        return a * b + c;
    }
};

using VariantBill = variant<OutPatient, InPatient>;

double variantTotal(const VariantBill& b) {
    return visit([](const auto& bill) {
        return bill.total();
    }, b);
}

int main() {
    vector<Bill*> virtualBills;
    vector<SimpleBill> switchBills;
    vector<VariantBill> variantBills;

    int sizes[] = {1000, 1000000, 10000000};

    for (int n : sizes) {
        virtualBills.clear();
        switchBills.clear();
        variantBills.clear();

        for (int i = 0; i < n; i++) {
            if (i % 2 == 0) {
                virtualBills.push_back(new OutPatient(500, 1200));
                switchBills.push_back({1, 500, 1200, 0});
                variantBills.push_back(OutPatient(500, 1200));
            } else {
                virtualBills.push_back(new InPatient(3, 2500, 40000));
                switchBills.push_back({2, 3, 2500, 40000});
                variantBills.push_back(InPatient(3, 2500, 40000));
            }
        }

        double virtualSum = 0;
        double switchSum = 0;
        double variantSum = 0;

        auto start = steady_clock::now();

        for (Bill* b : virtualBills) {
            virtualSum += b->total();
        }

        auto end = steady_clock::now();
        auto virtualTime = duration_cast<milliseconds>(end - start).count();

        start = steady_clock::now();

        for (const SimpleBill& b : switchBills) {
            switchSum += b.total();
        }

        end = steady_clock::now();
        auto switchTime = duration_cast<milliseconds>(end - start).count();

        start = steady_clock::now();

        for (const VariantBill& b : variantBills) {
            variantSum += variantTotal(b);
        }

        end = steady_clock::now();
        auto variantTime = duration_cast<milliseconds>(end - start).count();

        cout << "Number of Bills: " << n << endl;
        cout << "Virtual Total: " << virtualSum << endl;
        cout << "Switch Total: " << switchSum << endl;
        cout << "Variant Total: " << variantSum << endl;
        cout << "Virtual Time: " << virtualTime << " ms" << endl;
        cout << "Switch Time: " << switchTime << " ms" << endl;
        cout << "Variant Time: " << variantTime << " ms" << endl;
        cout << endl;

        for (Bill* b : virtualBills) {
            delete b;
        }
    }

    int invalidPercentages[] = {0, 1, 50};
    const int count = 1000000;

    for (int percentage : invalidPercentages) {
        int invalidCount = count * percentage / 100;
        int returnErrors = 0;
        int exceptionErrors = 0;
        double amount = 500;

        auto start = steady_clock::now();

        for (int i = 0; i < count; i++) {
            if (i < invalidCount) {
                returnErrors++;
            } else {
                amount += 1;
            }
        }

        auto end = steady_clock::now();
        auto returnTime = duration_cast<milliseconds>(end - start).count();

        start = steady_clock::now();

        for (int i = 0; i < count; i++) {
            try {
                if (i < invalidCount) {
                    throw runtime_error("Invalid bill");
                }

                amount += 1;
            }
            catch (const exception&) {
                exceptionErrors++;
            }
        }

        end = steady_clock::now();
        auto exceptionTime = duration_cast<milliseconds>(end - start).count();

        cout << "Invalid Bills: " << percentage << "%" << endl;
        cout << "Return Code Errors: " << returnErrors << endl;
        cout << "Exception Errors: " << exceptionErrors << endl;
        cout << "Return Code Time: " << returnTime << " ms" << endl;
        cout << "Exception Time: " << exceptionTime << " ms" << endl;
        cout << endl;
    }

    return 0;
}
