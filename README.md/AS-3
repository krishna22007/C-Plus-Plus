#include <iostream>
#include <string>
using namespace std;
class Book {
    string title;
    int copies;

public:
    Book() : Book("Unknown", 0) {
    }

    Book(string t) : Book(t, 0) {
    }

    Book(string t, int c) : title(t), copies(c < 0 ? 0 : c) {
    }

    void display() {
        cout << "Title: " << title << endl;
        cout << "Copies: " << copies << endl;
    }
};

int main() {
    Book b1;
    Book b2("C++ Programming");
    Book b3("Java Programming", 5);

    cout << "Default Book" << endl;
    b1.display();

    cout << "\nDonated Book" << endl;
    b2.display();

    cout << "\nComplete Book" << endl;
    b3.display();

    return 0;
}
