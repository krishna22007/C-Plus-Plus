#include <iostream>
using namespace std;

class Money
{
    int paise;

public:
    Money()
    {
        paise = 0;
    }

    Money(int p)
    {
        paise = p;
    }

    Money operator+(Money m)
    {
        return Money(paise + m.paise);
    }

    Money operator-(Money m)
    {
        return Money(paise - m.paise);
    }

    Money& operator+=(Money m)
    {
        paise += m.paise;
        return *this;
    }

    bool operator==(Money m)
    {
        return paise == m.paise;
    }

    bool operator<(Money m)
    {
        return paise < m.paise;
    }

    friend ostream& operator<<(ostream &out, Money m)
    {
        out << "Rs " << m.paise / 100 << ".";

        if (m.paise % 100 < 10)
            out << "0";

        out << m.paise % 100;
        return out;
    }

    friend istream& operator>>(istream &in, Money &m)
    {
        cout << "Enter amount in paise: ";
        in >> m.paise;
        return in;
    }
};

int main()
{
    Money m1(10000);
    Money m2(10000);

    Money m3 = m1 + m2;

    cout << "Total: " << m3 << endl;
    cout << boolalpha << (m1 == m2) << endl;

    m1 += m2;
    cout << "After addition: " << m1 << endl;

    return 0;
}
