#include <iostream>
using namespace std;

class Time
{
    int seconds;

public:
    Time(int s = 0)
    {
        seconds = s;
    }

    Time& operator++()
    {
        ++seconds;
        return *this;
    }

    Time operator++(int)
    {
        Time temp = *this;
        seconds++;
        return temp;
    }

    bool operator==(Time t)
    {
        return seconds == t.seconds;
    }

    bool operator<(Time t)
    {
        return seconds < t.seconds;
    }

    void display()
    {
        cout << seconds << endl;
    }
};

class Playlist
{
    string songs[5];

public:
    Playlist()
    {
        songs[0] = "Song 1";
        songs[1] = "Song 2";
        songs[2] = "Song 3";
        songs[3] = "Song 4";
        songs[4] = "Song 5";
    }

    string& operator[](int index)
    {
        if (index < 0 || index >= 5)
        {
            cout << "Invalid index" << endl;
            return songs[0];
        }

        return songs[index];
    }

    const string& operator[](int index) const
    {
        if (index < 0 || index >= 5)
        {
            return songs[0];
        }

        return songs[index];
    }
};

int main()
{
    Time t1(5);

    t1.display();

    Time t2 = t1++;
    t2.display();

    ++t1;
    t1.display();

    Playlist p;

    cout << p[0] << endl;

    p[1] = "Favorite Song";

    cout << p[1] << endl;

    return 0;
}
