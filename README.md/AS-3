#include <iostream>
#include <cmath>
using namespace std;

class Complex
{
    float real;
    float imag;

public:
    Complex()
    {
        real = 0;
        imag = 0;
    }

    Complex(float r, float i)
    {
        real = r;
        imag = i;
    }

    Complex operator+(Complex c)
    {
        return Complex(real + c.real, imag + c.imag);
    }

    Complex operator-(Complex c)
    {
        return Complex(real - c.real, imag - c.imag);
    }

    Complex operator*(Complex c)
    {
        return Complex(
            real * c.real - imag * c.imag,
            real * c.imag + imag * c.real
        );
    }

    Complex operator/(Complex c)
    {
        float denominator = c.real * c.real + c.imag * c.imag;

        if (denominator == 0)
        {
            cout << "Division by zero is not possible" << endl;
            return Complex(0, 0);
        }

        return Complex(
            (real * c.real + imag * c.imag) / denominator,
            (imag * c.real - real * c.imag) / denominator
        );
    }

    bool operator==(Complex c)
    {
        return real == c.real && imag == c.imag;
    }

    float magnitude()
    {
        return sqrt(real * real + imag * imag);
    }

    friend ostream& operator<<(ostream &out, Complex c)
    {
        out << c.real;

        if (c.imag >= 0)
            out << " + " << c.imag << "i";
        else
            out << " - " << -c.imag << "i";

        return out;
    }
};

int main()
{
    Complex c1(4, 3);
    Complex c2(2, 1);

    Complex sum = c1 + c2;
    Complex difference = c1 - c2;
    Complex product = c1 * c2;
    Complex division = c1 / c2;

    cout << "First Impedance: " << c1 << endl;
    cout << "Second Impedance: " << c2 << endl;

    cout << "Addition: " << sum << endl;
    cout << "Subtraction: " << difference << endl;
    cout << "Multiplication: " << product << endl;
    cout << "Division: " << division << endl;

    cout << "Magnitude: " << c1.magnitude() << endl;

    cout << boolalpha;
    cout << "Equal: " << (c1 == c2) << endl;

    return 0;
}
