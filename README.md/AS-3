#include <iostream>
#include <cstring>
using namespace std;

class Text
{
    char *data;

public:
    Text(const char *str = "")
    {
        data = new char[strlen(str) + 1];
        strcpy(data, str);
    }

    Text(const Text &t)
    {
        data = new char[strlen(t.data) + 1];
        strcpy(data, t.data);
    }

    Text& operator=(const Text &t)
    {
        if (this != &t)
        {
            delete[] data;

            data = new char[strlen(t.data) + 1];
            strcpy(data, t.data);
        }

        return *this;
    }

    Text operator+(const Text &t)
    {
        char *temp = new char[strlen(data) + strlen(t.data) + 1];

        strcpy(temp, data);
        strcat(temp, t.data);

        Text result(temp);

        delete[] temp;

        return result;
    }

    bool operator==(const Text &t)
    {
        return strcmp(data, t.data) == 0;
    }

    bool operator!=(const Text &t)
    {
        return strcmp(data, t.data) != 0;
    }

    friend ostream& operator<<(ostream &out, const Text &t)
    {
        out << t.data;
        return out;
    }

    ~Text()
    {
        delete[] data;
    }
};

int main()
{
    Text t1("Hello ");
    Text t2("World");

    Text t3 = t1 + t2;

    cout << "Combined Text: " << t3 << endl;

    cout << boolalpha;
    cout << "Equal: " << (t1 == t2) << endl;
    cout << "Not Equal: " << (t1 != t2) << endl;

    Text t4;
    t4 = t3;

    cout << "Copied Text: " << t4 << endl;

    return 0;
}
