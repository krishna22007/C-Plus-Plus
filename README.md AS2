#Q1: Call by value, reference and pointer:-
#include <iostream>
using namespace std;

void byValue(long long fee, int percent)      { fee -= fee * percent / 100; }     // copy
void byReference(long long& fee, int percent) { fee -= fee * percent / 100; }     // original
void byPointer(long long* fee, int percent)   { *fee -= *fee * percent / 100; }   // via address
long long applied(long long fee, int percent) { return fee - fee * percent / 100; } // returns new fee

int main()
{
    long long fee = 45000;
    byValue(fee, 10);      cout << "by value     : " << fee << '\n';
    byReference(fee, 10);  cout << "by reference : " << fee << '\n';
    byPointer(&fee, 10);   cout << "by pointer   : " << fee << '\n';

    long long f2 = applied(applied(45000, 10), 15);   // merit 10% then sports 15%
    cout << "merit+sports (returning style): " << f2 << '\n';
}
#Q2: Return by reference and its dangers:------------------------------------------------------------------------------------------------
#include <iostream>
#include <vector>
using namespace std;

int& highest(int marks[], int n)                  // reference INTO the array
{
    int best = 0;
    for (int i = 1; i < n; i++) if (marks[i] > marks[best]) best = i;
    return marks[best];
}
const int& highestConst(const int marks[], int n) // read-only reference
{
    int best = 0;
    for (int i = 1; i < n; i++) if (marks[i] > marks[best]) best = i;
    return marks[best];
}
int highestCopy(const int marks[], int n) { return highestConst(marks, n); }  // a copy

int& badFunction() { int local = 42; return local; }   // DANGER: local dies at the closing brace

int main()
{
    int marks[5] = {55, 88, 72, 91, 60};
    highest(marks, 5) += 2;                        // moderation +2 directly on the array
    for (int m : marks) cout << m << ' ';  cout << '\n';

    highest(marks, 5) = 100;                       // call on the LEFT of '='
    for (int m : marks) cout << m << ' ';  cout << '\n';

    int copy = highestCopy(marks, 5);  copy += 50; // changes only the copy
    cout << "copy = " << copy << ", array top still " << highestConst(marks, 5) << '\n';

    (void)&badFunction;                            // never call it: undefined behaviour
    vector<int> v = {55, 88, 72};
    int* before = &v[0];
    for (int i = 0; i < 1000; i++) v.push_back(i);
    cout << (before == &v[0] ? "vector did NOT move"
                             : "vector MOVED: old reference/pointer is now dangling") << '\n';
}
