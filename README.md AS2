// Q7: Original (shifting array) vs Redesign (circular buffer) ---------------------------------------------------------------------------------------------------------------------------------
#include <iostream>
#include <chrono>
using namespace std;
using namespace std::chrono;

// ORIGINAL: when full, shift every element one place left -> O(CAP) per transaction
template <int CAP>
class ShiftStatement {
    long tx[CAP];
    int count = 0;
public:
    void add(long amount)
    {
        if (count == CAP) {
            for (int i = 1; i < CAP; i++) tx[i - 1] = tx[i];
            tx[CAP - 1] = amount;
        } else tx[count++] = amount;
    }
    long get(int i) const { return tx[i]; }          // i = 0 is the oldest
    int size() const { return count; }
};

// REDESIGN: remember where the oldest item is; overwrite it -> O(1) per transaction
template <int CAP>
class RingStatement {
    long tx[CAP];
    int start = 0, count = 0;
public:
    void add(long amount)
    {
        if (count < CAP) tx[(start + count++) % CAP] = amount;
        else { tx[start] = amount; start = (start + 1) % CAP; }
    }
    long get(int i) const { return tx[(start + i) % CAP]; }   // i = 0 is the oldest
    int size() const { return count; }
};

template <class S>
double run(S& s, long n, long& checksum)
{
    auto t0 = steady_clock::now();
    for (long i = 1; i <= n; i++) s.add(i);
    auto t1 = steady_clock::now();
    checksum = 0;
    for (int i = 0; i < s.size(); i++) checksum += s.get(i) * (i + 1);   // order-sensitive
    return duration<double, milli>(t1 - t0).count();
}

template <int CAP>
void test(long n)
{
    static ShiftStatement<CAP> a;
    static RingStatement<CAP>  b;
    long ca, cb;
    double ta = run(a, n, ca), tb = run(b, n, cb);
    cout << "CAP=" << CAP << "  shift: " << ta << " ms   ring: " << tb << " ms   same result: "
         << (ca == cb ? "yes" : "NO") << '\n';
}

int main()
{
    const long N = 200000;                    // 200,000 transactions
    cout << "adding " << N << " transactions\n";
    test<10>(N);
    test<100>(N);
    test<1000>(N);
    test<10000>(N);
}
