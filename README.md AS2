Q4: A class with an array inside it:----------------------------------------------------------------------------------------------------------
#include <iostream>
using namespace std;

class SavingsAccount {
    int  accNo;
    long balance;
    long tx[10];       // last 10 transactions, PRIVATE so nobody can corrupt it
    int  count;

public:
    SavingsAccount(int no, long opening) : accNo(no), balance(opening), count(0) {}
    long getBalance() const { return balance; }     // defined inside the class

    void deposit(long amt);                         // defined outside with ::
    bool withdraw(long amt);
    void miniStatement() const;

private:
    void record(long amount);
};

void SavingsAccount::record(long amount)
{
    if (count == 10) {                              // the 11th transaction arrives
        for (int i = 1; i < 10; i++) tx[i - 1] = tx[i];   // shift left, dropping the oldest
        tx[9] = amount;
    } else tx[count++] = amount;
}
void SavingsAccount::deposit(long amt) { balance += amt; record(+amt); }
bool SavingsAccount::withdraw(long amt)
{
    if (amt > balance) return false;
    balance -= amt; record(-amt); return true;
}
void SavingsAccount::miniStatement() const
{
    cout << "Account " << accNo << " mini-statement\n";
    for (int i = 0; i < count; i++)
        cout << "  " << (tx[i] >= 0 ? "Deposit   " : "Withdrawal") << " " << (tx[i] >= 0 ? tx[i] : -tx[i]) << '\n';
    cout << "  Balance: " << balance << '\n';
}

int main()
{
    SavingsAccount a(1001, 5000);
    for (int i = 1; i <= 8; i++) a.deposit(i * 100);
    a.withdraw(250);
    a.withdraw(100);
    a.deposit(999);          // the 11th transaction: the oldest (100) is discarded
    a.miniStatement();
}
