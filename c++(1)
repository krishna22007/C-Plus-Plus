Task 12: Day-4 Design Challenge (4thZone,
Discounts & Passes):- PROGRAM CODE:-------------------------------------------------------------------------------------------------------------------------
#include
enum class Zone { Inner = 1, Middle, Outer, Airport };
constexpr long long BASE_PAISE[] = { 1000, 2000, 3000, 6000 };
class Pass {
private:
Zone z1, z2;
public:
Pass(Zone a, Zone b) : z1(a), z2(b) {}
bool covers(Zone z) const { return z == z1 || z == z2; }
};
long long getFare(Zone z, bool peak, bool weekend, const Pass* pass) {
if (pass && pass->covers(z)) return 0; // Covered by monthly pass
long long base = BASE_PAISE[static_cast(z) - 1];
if (weekend) {
base -= (base * 10) / 100; // 10% Weekend discount
} else if (peak) {
base += (base * 20) / 100; // 20% Peak surcharge
}
return base;
}
int main() {
std::cout << "=== Task 12: Day-4 Design Challenge ===" << std::endl;
Pass myPass(Zone::Inner, Zone::Middle);
std::cout << "Airport Zone Fare (Weekend): Rs " << getFare(Zone::Airport, false, true, nullptr) / 100.0 << std::endl;
std::cout << "Inner Zone Fare with Pass: Rs " << getFare(Zone::Inner, true, false, &myPass) / 100.0 << std::endl;
return 0;
}
